{
  "invokeCaps": [
    {
      "id": "1001295",
      "key": "com.android.launcher.open_in_application_display_taskbar",
      "packageName": "com.android.launcher",
      "name": "打开在应用底部显示任务栏",
      "version": "1.0.3",
      "versionCode": "1000003",
      "tags": [
        "折叠屏专区",
        "在应用底部显示任务栏"
      ],
      "description": "在应用底部显示任务栏属于开关类设置项，主要功能是帮助用户在应用中也可以在底部使用任务栏，可以在任务栏中快速进入其他应用。打开在应用底部显示任务栏是在应用底部显示任务栏设置项的一个具体操作指令，主要用于功能打开后进入应用也会显示任务栏。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_MESSENGER",
          "attributes": {
            "msgWhat": "3",
            "packageName": "com.android.launcher",
            "className": "com.android.launcher.breeno.LauncherBreenoService",
            "extras": [
              {
                "key": "switch_action_value",
                "type": "int32",
                "value": "1"
              }
            ],
            "permission": "com.oplus.permission.safe.ASSISTANT",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你在应用底部显示任务栏。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你在应用底部显示任务栏。"
              }
            ]
          }
        }
      }
    },
