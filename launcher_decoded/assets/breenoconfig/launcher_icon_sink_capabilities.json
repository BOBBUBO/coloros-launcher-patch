{
  "invokeCaps": [
    {
      "id": "1000867",
      "key": "com.android.launcher.open_launcher_icon_sink",
      "name": "打开图标下沉",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "桌面与锁屏",
        "图标下沉"
      ],
      "description": "图标下沉属于开关类设置项，主要功能是在桌面时，从屏幕左侧或者右侧向上滑动，触发应用图标下沉。打开图标下沉是图标下沉设置项的一个具体操作指令，主要用于继续滑动至应用图标松手，即可快速打开应用。。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_CONTENT_PROVIDER",
          "attributes": {
            "authority": "com.android.launcher.LauncherBreenoProvider",
            "type": "CALL",
            "method": "set_launcher_icon_fallen",
            "extras": [
              {
                "key": "switch_action_value",
                "type": "int32",
                "value": "1"
              }
            ],
            "permission": "com.oplus.permission.safe.ASSISTANT",
            "response": [
              {
                "key": "deep_link",
                "type": "string",
                "value": "launcher://IconFallenSetting"
              },
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你打开图标下沉开关。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你打开图标下沉开关。"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1001027",
      "key": "com.android.launcher.close_launcher_icon_sink",
      "name": "关闭图标下沉",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "桌面与锁屏",
        "图标下沉"
      ],
      "description": "图标下沉属于开关类设置项，主要功能是关闭后在桌面时无法从屏幕左侧或者右侧向上滑动，触发应用图标下沉。关闭图标下沉是图标下沉设置项的一个具体操作指令，主要用于当用户不想通过从屏幕左侧或者右侧向上滑动，触发应用图标下沉时，可以关闭该功能。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_CONTENT_PROVIDER",
          "attributes": {
            "authority": "com.android.launcher.LauncherBreenoProvider",
            "type": "CALL",
            "method": "set_launcher_icon_fallen",
            "extras": [
              {
                "key": "switch_action_value",
                "type": "int32",
                "value": "2"
              }
            ],
            "permission": "com.oplus.permission.safe.ASSISTANT",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你关闭图标下沉开关。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你关闭图标下沉开关。"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1001028",
      "key": "com.android.launcher.set_launcher_icon_sink",
      "name": " 跳转图标下沉设置页",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "桌面与锁屏",
        "图标下沉"
      ],
      "description": "图标下沉属于页面类设置项，主要功能是在桌面时可以从屏幕左侧或者右侧向上滑动，触发应用图标下沉。。 跳转图标下沉设置页是图标下沉设置项的一个具体操作指令，主要用于跳转到图标下沉设置页面可以帮助用户快速调整该功能开启还是关闭。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_START_ACTIVITY",
          "attributes": {
            "packageName": "com.android.launcher",
            "className": "com.android.launcher.settings.LauncherIconFallenSettingActivity",
            "action": "com.android.launcher.action.LAUNCHER_ICON_FALLEN",
            "permission": "com.oplus.permission.safe.SECURITY",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你跳转图标下沉设置项。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你跳转图标下沉设置项。"
              },
              {
                "key": "deep_link",
                "type": "string",
                "value": "launcher://IconFallenSetting"
              }
            ]
          }
        }
      }
    }
  ]
}