{
  "invokeCaps": [
    {
      "id": "1000938",
      "key": "com.android.launcher.set_launcher_mode",
      "name": "设置桌面模式",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "桌面与锁屏",
        "桌面模式"
      ],
      "description": "桌面模式属于选择类设置项，主要功能是改变桌面使用样式。设置桌面模式是桌面模式设置项的一个具体操作指令，主要用于切换至标准模式时所有应用都会出现在桌面上。切换至抽屉模式时所有应用都会收进抽屉里，用户可以选择需要的图标放到桌面上。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_MESSENGER",
          "attributes": {
            "msgWhat": "1",
            "packageName": "com.android.launcher",
            "className": "com.android.launcher.breeno.LauncherBreenoService",
            "permission": "com.oplus.permission.safe.ASSISTANT"
          }
        },
        "inputParams": [
          {
            "key": "launcher_mode_value",
            "type": "string",
            "required": false,
            "description": "桌面模式类型，取值范围不定，可能为[标准模式;抽屉模式]，可缺失",
            "name": "使用样式"
          }
        ]
      }
    }
  ]
}