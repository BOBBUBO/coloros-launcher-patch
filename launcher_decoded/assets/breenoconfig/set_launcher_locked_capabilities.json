{
  "invokeCaps": [
    {
      "id": "1000974",
      "key": "com.android.launcher.open_launcher_locked_switch",
      "name": "打开锁定桌面开关",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "设置",
        "锁定桌面"
      ],
      "description": "锁定桌面属于开关类设置项，主要功能是锁定桌面之后不可改变桌面布局，删除或移动图标。打开锁定桌面开关是锁定桌面设置项的一个具体操作指令，主要用于打开桌面锁定功能之后，桌面将无法移动或删除图标。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_CONTENT_PROVIDER",
          "attributes": {
            "authority": "com.android.launcher.LauncherBreenoProvider",
            "type": "CALL",
            "method": "set_launcher_locked",
            "extras": [
              {
                "key": "switch_action_value",
                "type": "int32",
                "value": "1"
              }
            ],
            "permission": "com.oplus.permission.safe.ASSISTANT",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你打开锁定桌面开关。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你打开锁定桌面开关。"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1000975",
      "key": "com.android.launcher.close_launcher_locked_switch",
      "name": "关闭锁定桌面开关",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "设置",
        "锁定桌面"
      ],
      "description": "锁定桌面属于开关类设置项，主要功能是锁定桌面之后不可改变桌面布局，删除或移动图标。关闭锁定桌面开关是锁定桌面设置项的一个具体操作指令，主要用于关闭该功能后桌面可以正常使用。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_CONTENT_PROVIDER",
          "attributes": {
            "authority": "com.android.launcher.LauncherBreenoProvider",
            "type": "CALL",
            "method": "set_launcher_locked",
            "extras": [
              {
                "key": "switch_action_value",
                "type": "int32",
                "value": "2"
              }
            ],
            "permission": "com.oplus.permission.safe.ASSISTANT",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你关闭锁定桌面开关。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你关闭锁定桌面开关。"
              }
            ]
          }
        }
      }
    },
    {
      "id": "1000976",
      "key": "com.android.launcher.set_launcher_locked",
      "name": "设置锁定桌面",
      "version": "1.0.0",
      "versionCode": "1000000",
      "tags": [
        "设置",
        "设置锁定桌面"
      ],
      "description": "设置锁定桌面属于页面类设置项，主要功能是设置后桌面将固定布局无法删除和移动图表。设置锁定桌面是设置锁定桌面设置项的一个具体操作指令，主要用于跳转到锁定桌面设置页面帮助用户调整功能开启还是关闭。",
      "invoke": {
        "protocol": {
          "type": "ApiProxy",
          "apiType": "ANDROID_START_ACTIVITY",
          "attributes": {
            "packageName": "com.android.launcher",
            "className": "com.android.launcher.settings.LauncherSettingsActivity",
            "action": "com.android.launcher.action.settings.LAUNCHER_SETTINGS",
            "permission": "com.oplus.permission.safe.SETTINGS",
            "response": [
              {
                "key": "apiproxy_biz_text",
                "type": "string",
                "value": "好的，已为你跳转锁定桌面设置项。"
              },
              {
                "key": "apiproxy_biz_tts",
                "type": "string",
                "value": "好的，已为你跳转锁定桌面设置项。"
              }
            ]
          }
        }
      }
    }
  ]
}