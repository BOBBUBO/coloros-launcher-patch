<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="100" android:exitFadeDuration="360"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <color android:color="@color/coui_list_selector_color_disabled" />
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:bottomLeftRadius="24.0dp" android:bottomRightRadius="24.0dp" />
            <solid android:color="?couiColorPressBackground" />
        </shape>
    </item>
    <item>
        <color android:color="@null" />
    </item>
</selector>
