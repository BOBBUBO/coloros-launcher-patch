<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">
    <item android:id="@id/indicator_solid">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/materialColorPaletteKeyColorPrimary" />
            <corners android:radius="28.0dp" />
        </shape>
    </item>
    <item android:id="@id/indicator_stroke">
        <shape android:shape="rectangle">
            <corners android:radius="28.0dp" />
            <stroke android:width="2.0dp" android:color="@android:color/materialColorPaletteKeyColorPrimary" />
        </shape>
    </item>
</layer-list>
