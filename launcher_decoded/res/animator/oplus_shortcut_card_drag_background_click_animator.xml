<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <objectAnimator android:interpolator="@anim/coui_ease" android:duration="100" android:valueTo="0" android:valueType="floatType" android:propertyName="alpha" />
    </item>
    <item android:state_selected="true">
        <objectAnimator android:interpolator="@anim/coui_ease" android:duration="100" android:valueFrom="0.5" android:valueTo="1" android:valueType="floatType" android:propertyName="alpha" />
    </item>
</selector>
